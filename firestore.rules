rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ready() {
      let gate = get(/databases/$(database)/documents/config/battle).data;
      return gate.rulesVersion == 4 && gate.defeatLimit == 5 && gate.maintenance == false;
    }
    // Only the IAM-authorized migration/scheduler can alter rollout gates/backups.
    match /config/{id} { allow read: if signedIn(); allow write: if false; }
    match /migrationBackups/{id} { allow read, write: if false; }
    match /dailyBattleSecrets/{day} { allow read, write: if false; }
    match /dailyBattles/{day} { allow read: if signedIn(); allow write: if false; }
    function dailyRenameWallet(wallet,at) {
      let start = at < wallet.updatedAt ? at : wallet.updatedAt;
      let elapsed = int(math.floor((at - start) / 60000.0));
      let gained = elapsed > 0 ? elapsed : 0;
      let uncapped = wallet.balance + gained;
      let balance = wallet.balance >= 3000 ? wallet.balance : (uncapped > 3000 ? 3000 : uncapped);
      return {'balance': balance - 100, 'updatedAt': balance >= 3000 ? at : start + gained * 60000};
    }
    function validDailyRename(day,side,d) {
      let battle = get(/databases/$(database)/documents/dailyBattles/$(day)).data;
      let before = get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data;
      let after = getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data;
      let operation = 'daily-rename-' + day + '-' + side;
      let receipt = getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)/operations/$(operation)).data;
      return (side == '0' || side == '1') && !exists(/databases/$(database)/documents/dailyBattleNames/$(day)/fighters/$(side))
        && d.keys().hasOnly(['day','side','name','uid','operationId','cost','renamedAt'])
        && d.uid == request.auth.uid && d.day == day && d.side == (side == '0' ? 0 : 1)
        && d.cost == 100 && d.operationId == operation && d.renamedAt == request.time
        && d.name is string && d.name.matches('^.{1,8}$') && d.name == d.name.trim()
        && d.name != battle.fighters[d.side].name
        && battle.status == 'open' && request.time.toMillis() >= battle.openAt && request.time.toMillis() < battle.closeAt
        && receipt.keys().hasOnly(['kind','day','side','name','cost','at'])
        && receipt.kind == 'dailyBattleRename' && receipt.day == day && receipt.side == d.side && receipt.name == d.name && receipt.cost == 100
        && receipt.at is int && receipt.at <= request.time.toMillis()+5000 && receipt.at >= request.time.toMillis()-60000
        && after.wallet == dailyRenameWallet(before.wallet,receipt.at) && after.wallet.balance >= 0
        && after.revision == before.revision + 1 && operation in after.recentOperations
        && after.diff(before).affectedKeys().hasOnly(['wallet','revision','recentOperations']);
    }
    match /dailyBattleNames/{day}/fighters/{side} {
      allow read: if signedIn();
      allow create: if signedIn() && ready() && validDailyRename(day,side,request.resource.data);
      allow update, delete: if false;
    }
    function validDailyRenameReceipt(id) {
      let d = request.resource.data;
      let side = d.side == 0 ? '0' : '1';
      let naming = getAfter(/databases/$(database)/documents/dailyBattleNames/$(d.day)/fighters/$(side)).data;
      return d.side is int && d.side >= 0 && d.side <= 1
        && id == 'daily-rename-' + d.day + '-' + side && validDailyRename(d.day,side,naming);
    }
    function validDailyVote(d,uid) {
      let battle = get(/databases/$(database)/documents/dailyBattles/$(d.day)).data;
      return d.keys().hasOnly(['uid','day','choice','votedAt','settled','settledAt'])
        && d.uid == uid && d.choice is int && d.choice >= 0 && d.choice <= 4
        && d.settled == false && d.settledAt == null && d.votedAt == request.time
        && battle.status == 'open'
        && request.time.toMillis() >= battle.openAt && request.time.toMillis() < battle.closeAt;
    }
    function dailyBattleReceipt(uid,day,choice) {
      let receipt = getAfter(/databases/$(database)/documents/wallets/$(uid)/operations/$('daily-battle-' + day)).data;
      return receipt.kind == 'dailyBattle' && receipt.day == day
        && receipt.amount == ((choice == 1 || choice == 3) ? 100 : 300);
    }
    match /dailyBattlePlayers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && ready() && request.auth.uid == uid && validDailyVote(request.resource.data,uid);
      allow update: if signedIn() && ready() && request.auth.uid == uid
        && ((resource.data.settled == true && request.resource.data.day > resource.data.day && validDailyVote(request.resource.data,uid))
          || (resource.data.settled == false && request.resource.data.settled == true
            && request.resource.data.settledAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settled','settledAt'])
            && get(/databases/$(database)/documents/dailyBattles/$(resource.data.day)).data.status == 'finished'
            && (resource.data.choice != get(/databases/$(database)/documents/dailyBattles/$(resource.data.day)).data.outcome
              || dailyBattleReceipt(uid,resource.data.day,resource.data.choice))));
      allow delete: if false;
    }
    function validDailyBattleClaim(uid,id) {
      let d = request.resource.data;
      let battle = get(/databases/$(database)/documents/dailyBattles/$(d.day)).data;
      let vote = get(/databases/$(database)/documents/dailyBattlePlayers/$(uid)).data;
      let nextVote = getAfter(/databases/$(database)/documents/dailyBattlePlayers/$(uid)).data;
      let before = get(/databases/$(database)/documents/wallets/$(uid)).data;
      let after = getAfter(/databases/$(database)/documents/wallets/$(uid)).data;
      return id == 'daily-battle-' + d.day && d.kind == 'dailyBattle'
        && d.keys().hasOnly(['kind','day','amount','at'])
        && battle.status == 'finished' && vote.day == d.day && vote.settled == false && vote.choice == battle.outcome
        && nextVote.day == vote.day && nextVote.settled == true
        && d.amount == ((vote.choice == 1 || vote.choice == 3) ? 100 : 300)
        && after.revision == before.revision + 1 && after.wallet.balance >= before.wallet.balance + d.amount
        && id in after.recentOperations;
    }
    match /announcements/{id} {
      allow read: if signedIn() && resource.data.published == true;
      allow write: if false;
    }
    match /owners/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow update: if signedIn() && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'unreadBattleIds','suspended','seenBattleSeq','seenLegendSeq','tutorialSeen',
          'suspendedAt','lastAccessAt','dormant'
        ]);
      allow delete: if false;
    }
    match /wallets/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && ready() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow delete: if false;
      match /operations/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && ready() && request.auth.uid == uid
          && (!id.matches('daily-battle-.*') || validDailyBattleClaim(uid,id))
          && (!id.matches('daily-rename-.*') || validDailyRenameReceipt(id));
        allow update, delete: if false;
      }
    }
    match /meta/{id} { allow read: if signedIn(); allow write: if signedIn() && ready() && id != 'dailyBattle'; }
    function validRecord(d) {
      return d.rulesVersion == 4 && d.defeats is int && d.defeats >= 0 && d.defeats <= 10
        && d.stars is int && d.stars >= 0 && d.stars <= 50
        && d.maxHp is int && d.maxHp >= 5 && d.maxHp <= 8 && d.currentHp == d.maxHp
        && d.poisoned == false && d.cursedSlots == [] && d.recordVersion is int
        && ((d.status == 'dead' && d.defeats >= 5)
          || (d.status == 'legend' && d.defeats < 10 && d.stars == 50)
          || (d.status == 'active' && d.defeats < 10 && d.stars < 50));
    }
    // Grandfather active 5..9-skull residents until they acquire another skull.
    function validDefeatTransition(before, next) {
      return (next.defeats == before.defeats || next.defeats == before.defeats + 1)
        && ((next.status == 'dead') == (next.defeats > before.defeats && next.defeats >= 5));
    }
    function matchWrite(d, id) {
      let log = getAfter(/databases/$(database)/documents/battles/$(d.lastBattleId)).data;
      return log.rulesVersion == 4 && log.defeatLimit == 5 && ((log.emojinIds[0] == id && log.after[0] == d)
        || (log.emojinIds[1] == id && log.after[1] == d));
    }
    function npcWrite(d,id) {
      let log = getAfter(/databases/$(database)/documents/battles/$(d.lastBattleId)).data;
      return d.isNpc == true && d.ownerUid == 'npc' && d.stars == 0 && d.defeats == 0
        && d.recordVersion == 0 && log.rulesVersion == 4 && log.defeatLimit == 5
        && id.matches(d.lastBattleId + '-npc-[0-9]+');
    }
    function validOpponents(aId,bId) {
      let a = get(/databases/$(database)/documents/emojins/$(aId)).data;
      let b = get(/databases/$(database)/documents/emojins/$(bId)).data;
      return a.isNpc == true || b.isNpc == true || a.ownerUid == 'npc' || b.ownerUid == 'npc'
        || a.ownerUid != b.ownerUid;
    }
    match /emojins/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && ready() && validRecord(request.resource.data)
        && request.resource.data.id == id
        && ((request.resource.data.ownerUid == request.auth.uid && request.resource.data.isNpc == false
          && request.resource.data.stars == 0 && request.resource.data.defeats == 0 && request.resource.data.recordVersion == 0
          && get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.draft.id == id)
          || npcWrite(request.resource.data,id));
      allow update: if signedIn() && ready() && resource.data.status == 'active'
        && validRecord(request.resource.data)
        && request.resource.data.id == resource.data.id && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.isNpc == resource.data.isNpc
        && request.resource.data.maxHp == resource.data.maxHp
        && request.resource.data.recordVersion == resource.data.recordVersion + 1
        && validDefeatTransition(resource.data, request.resource.data)
        && request.resource.data.stars >= resource.data.stars
        && matchWrite(request.resource.data,id);
      allow delete: if false;
    }
    match /battles/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && ready() && request.resource.data.rulesVersion == 4 && request.resource.data.defeatLimit == 5
        && request.resource.data.emojinIds.size() == 2 && request.resource.data.after.size() == 2
        && request.resource.data.emojinIds[0] != request.resource.data.emojinIds[1]
        && validOpponents(request.resource.data.emojinIds[0],request.resource.data.emojinIds[1])
        && request.resource.data.after[0].lastBattleId == id && request.resource.data.after[1].lastBattleId == id
        && validRecord(request.resource.data.after[0]) && validRecord(request.resource.data.after[1])
        && getAfter(/databases/$(database)/documents/emojins/$(request.resource.data.emojinIds[0])).data == request.resource.data.after[0]
        && getAfter(/databases/$(database)/documents/emojins/$(request.resource.data.emojinIds[1])).data == request.resource.data.after[1];
      allow update, delete: if false;
    }
    match /legends/{id} { allow read: if signedIn(); allow create: if signedIn() && ready(); allow update, delete: if false; }
  }
}
