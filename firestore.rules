rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ready() {
      let gate = get(/databases/$(database)/documents/config/battle).data;
      return gate.rulesVersion == 4 && gate.defeatLimit == 5 && gate.maintenance == false;
    }
    // Only the IAM-authorized migration/scheduler can alter rollout gates/backups.
    match /config/{id} { allow read: if signedIn(); allow write: if false; }
    match /migrationBackups/{id} { allow read, write: if false; }
    // Daily Battle is retired, including votes, naming and unclaimed prizes.
    // Keep archived documents; no client may read or write them.
    match /dailyBattleSecrets/{document=**} { allow read, write: if false; }
    match /dailyBattles/{document=**} { allow read, write: if false; }
    match /dailyBattleNames/{document=**} { allow read, write: if false; }
    match /dailyBattlePlayers/{document=**} { allow read, write: if false; }
    match /announcements/{id} {
      allow read: if signedIn() && resource.data.published == true;
      allow write: if false;
    }
    match /owners/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow update: if signedIn() && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'unreadBattleIds','suspended','seenBattleSeq','seenLegendSeq','tutorialSeen',
          'suspendedAt','lastAccessAt','dormant'
        ]);
      allow delete: if false;
    }
    match /wallets/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && ready() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow delete: if false;
      match /operations/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && ready() && request.auth.uid == uid
          && !id.matches('daily-battle-.*')
          && !id.matches('daily-rename-.*')
          && (!id.matches('adventure-.*') || validAdventureOperation(request.resource.data,uid,id));
        allow update, delete: if false;
      }
    }
    match /meta/{id} { allow read: if signedIn() && id != 'dailyBattle'; allow write: if signedIn() && ready() && id != 'dailyBattle'; }
    function validRecord(d) {
      return d.rulesVersion == 4 && d.defeats is int && d.defeats >= 0 && d.defeats <= 10
        && d.stars is int && d.stars >= 0 && d.stars <= 50
        && d.maxHp is int && d.maxHp >= 5 && d.maxHp <= 8 && d.currentHp == d.maxHp
        && d.poisoned == false && d.cursedSlots == [] && d.recordVersion is int
        && ((d.status == 'dead' && d.defeats >= 5)
          || (d.status == 'legend' && d.defeats < 10 && d.stars == 50)
          || (d.status == 'active' && d.defeats < 10 && d.stars < 50));
    }
    // Grandfather active 5..9-skull residents until they acquire another skull.
    function validDefeatTransition(before, next) {
      return (next.defeats == before.defeats || next.defeats == before.defeats + 1)
        && ((next.status == 'dead') == (next.defeats > before.defeats && next.defeats >= 5));
    }
    function matchWrite(d, id) {
      let log = getAfter(/databases/$(database)/documents/battles/$(d.lastBattleId)).data;
      return log.rulesVersion == 4 && log.defeatLimit == 5 && ((log.emojinIds[0] == id && log.after[0] == d)
        || (log.emojinIds[1] == id && log.after[1] == d));
    }
    function npcWrite(d,id) {
      let log = getAfter(/databases/$(database)/documents/battles/$(d.lastBattleId)).data;
      return d.isNpc == true && d.ownerUid == 'npc' && d.stars == 0 && d.defeats == 0
        && d.recordVersion == 0 && log.rulesVersion == 4 && log.defeatLimit == 5
        && id.matches(d.lastBattleId + '-npc-[0-9]+');
    }
    function validOpponents(aId,bId) {
      let a = get(/databases/$(database)/documents/emojins/$(aId)).data;
      let b = get(/databases/$(database)/documents/emojins/$(bId)).data;
      return a.isNpc == true || b.isNpc == true || a.ownerUid == 'npc' || b.ownerUid == 'npc'
        || a.ownerUid != b.ownerUid;
    }
    match /emojins/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && ready() && validRecord(request.resource.data)
        && request.resource.data.id == id
        && ((request.resource.data.ownerUid == request.auth.uid && request.resource.data.isNpc == false
          && request.resource.data.stars == 0 && request.resource.data.defeats == 0 && request.resource.data.recordVersion == 0
          && get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.draft.id == id)
          || npcWrite(request.resource.data,id));
      allow update: if signedIn() && ready() && resource.data.status == 'active'
        && validRecord(request.resource.data)
        && request.resource.data.id == resource.data.id && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.isNpc == resource.data.isNpc
        && request.resource.data.maxHp == resource.data.maxHp
        && request.resource.data.recordVersion == resource.data.recordVersion + 1
        && validDefeatTransition(resource.data, request.resource.data)
        && request.resource.data.stars >= resource.data.stars
        && matchWrite(request.resource.data,id);
      allow delete: if false;
    }
    match /battles/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && ready() && request.resource.data.rulesVersion == 4 && request.resource.data.defeatLimit == 5
        && request.resource.data.emojinIds.size() == 2 && request.resource.data.after.size() == 2
        && request.resource.data.emojinIds[0] != request.resource.data.emojinIds[1]
        && validOpponents(request.resource.data.emojinIds[0],request.resource.data.emojinIds[1])
        && request.resource.data.after[0].lastBattleId == id && request.resource.data.after[1].lastBattleId == id
        && validRecord(request.resource.data.after[0]) && validRecord(request.resource.data.after[1])
        && getAfter(/databases/$(database)/documents/emojins/$(request.resource.data.emojinIds[0])).data == request.resource.data.after[0]
        && getAfter(/databases/$(database)/documents/emojins/$(request.resource.data.emojinIds[1])).data == request.resource.data.after[1];
      allow update, delete: if false;
    }
    // Paid minigame leaderboard: authenticated readers, one best score per player.
    // This follows the existing client-resolved game trust model; it is not an anti-cheat server.
    function adventureCounter(e,k) { return e.get(k,0) is int && e.get(k,0) >= 0; }
    function validAdventureEvents(e) {
      return e.keys().hasOnly(['mobHp','bomb','heart','chest','fullheal','midboss','floor','bossHeart','randomEncounter','mapEncounter','level'])
        && adventureCounter(e,'mobHp') && adventureCounter(e,'bomb') && adventureCounter(e,'heart')
        && adventureCounter(e,'chest') && adventureCounter(e,'fullheal') && adventureCounter(e,'midboss')
        && adventureCounter(e,'floor') && adventureCounter(e,'bossHeart') && adventureCounter(e,'randomEncounter')
        && adventureCounter(e,'mapEncounter') && adventureCounter(e,'level');
    }
    function adventurePaid(d,uid) {
      let old = get(/databases/$(database)/documents/wallets/$(uid)).data;
      let next = getAfter(/databases/$(database)/documents/wallets/$(uid)).data;
      let minutes = d.at > old.wallet.updatedAt ? int((d.at - old.wallet.updatedAt) / 60000) : 0;
      let recovered = old.wallet.balance + minutes;
      let accrued = old.wallet.balance >= 3000 ? old.wallet.balance : (recovered > 3000 ? 3000 : recovered);
      return d.at is int && d.at <= request.time.toMillis()+60000 && accrued >= 100
        && next.wallet.balance == accrued - 100 && next.revision == old.revision+1;
    }
    function validAdventureOperation(d,uid,id) {
      return (d.kind == 'adventureStart' && d.runId == id && d.uid == uid && d.version == 3 && d.cost == 100
        && d.player.id is string
        && get(/databases/$(database)/documents/emojins/$(d.player.id)).data.ownerUid == uid
        && get(/databases/$(database)/documents/emojins/$(d.player.id)).data.status == 'active'
        && get(/databases/$(database)/documents/emojins/$(d.player.id)).data.isNpc == false
        && d.player.maxHp == get(/databases/$(database)/documents/emojins/$(d.player.id)).data.maxHp
        && d.player.slots == get(/databases/$(database)/documents/emojins/$(d.player.id)).data.slots
        && adventurePaid(d,uid))
        || (d.kind == 'adventureResult' && id == d.runId + '-result' && d.uid == uid && d.version == 3
        && get(/databases/$(database)/documents/wallets/$(uid)/operations/$(d.runId)).data.kind == 'adventureStart'
        && validAdventureEvents(d.events) && d.score is int && d.score == adventureScore(d.events));
    }
    function adventureScore(e) {
      return e.get('mobHp',0)*400 + e.get('bomb',0)*100 + e.get('heart',0)*100
        + e.get('chest',0)*300 + e.get('fullheal',0)*300 + e.get('midboss',0)*1000
        + e.get('floor',0)*500 + e.get('bossHeart',0)*100
        + e.get('randomEncounter',0)*300 + e.get('mapEncounter',0)*500 + e.get('level',0)*1000;
    }
    function validAdventureScore(d,uid) {
      let result = getAfter(/databases/$(database)/documents/wallets/$(uid)/operations/$(d.runId + '-result')).data;
      let paid = get(/databases/$(database)/documents/wallets/$(uid)/operations/$(d.runId)).data;
      return d.keys().hasOnly(['uid','name','version','score','runId','finishedAt'])
        && d.uid == uid && d.version == 3 && d.score is int && d.score >= 0
        && d.name == get(/databases/$(database)/documents/owners/$(uid)).data.name
        && paid.kind == 'adventureStart' && paid.uid == uid && paid.cost == 100
        && result.kind == 'adventureResult' && result.uid == uid && result.version == 3
        && result.runId == d.runId && result.score == d.score
        && result.score == adventureScore(result.events);
    }
    function validAdventureBoard(d,uid) {
      let result = getAfter(/databases/$(database)/documents/wallets/$(uid)/operations/$(d.latestRunId + '-result')).data;
      let paid = get(/databases/$(database)/documents/wallets/$(uid)/operations/$(d.latestRunId)).data;
      let wallet = getAfter(/databases/$(database)/documents/wallets/$(uid)).data;
      return d.keys().hasOnly(['uid','name','version','score','runId','finishedAt','entries','latestRunId'])
        && d.uid == uid && d.version == 3 && d.score is int && d.score >= 0
        && d.name == get(/databases/$(database)/documents/owners/$(uid)).data.name
        && d.entries is list && d.entries.size() > 0 && d.entries.size() <= 10
        && d.entries == wallet.adventureScoresV3
        && d.score == d.entries[0].score && d.runId == d.entries[0].runId
        && d.finishedAt == d.entries[0].finishedAt
        && paid.kind == 'adventureStart' && paid.uid == uid && paid.cost == 100
        && result.kind == 'adventureResult' && result.uid == uid && result.version == 3
        && result.runId == d.latestRunId && validAdventureEvents(result.events)
        && result.score == adventureScore(result.events);
    }
    match /adventureScoresV3/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && ready() && request.auth.uid == uid
        && (validAdventureScore(request.resource.data,uid) || validAdventureBoard(request.resource.data,uid));
      allow update: if signedIn() && ready() && request.auth.uid == uid
        && ((request.resource.data.score > resource.data.score && validAdventureScore(request.resource.data,uid))
          || (request.resource.data.score >= resource.data.score && validAdventureBoard(request.resource.data,uid)));
      allow delete: if false;
    }
    match /legends/{id} { allow read: if signedIn(); allow create: if signedIn() && ready(); allow update, delete: if false; }
  }
}
